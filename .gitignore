# See https://git-scm.com/docs/gitignore for more about ignoring files.

# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
jspm_packages/

# Build output
dist/
build/

# Temporary files
*.tmp
*.swp
*.swo
*.bak

# Webpack specific
.cache/
*.cache
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# IDEs and editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db